rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // One document per finished quiz. Anyone signed in can add their own; nobody can edit or delete.
    match /results/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.score is int
        && request.resource.data.total is int
        && request.resource.data.total > 0 && request.resource.data.total <= 100
        && request.resource.data.score >= 0 && request.resource.data.score <= request.resource.data.total
        && request.resource.data.lesson is string && request.resource.data.lesson.size() <= 40
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.ts == request.time;
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }

    // Participant profile (name, email, last seen).
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Admin list. Three ways in:
    //  1. by hand in the Firebase console;
    //  2. an existing admin grants it from the admin page;
    //  3. the user enters the current access code (config/admin.code, at least 16 characters).
    function codeOk() {
      return exists(/databases/$(database)/documents/config/admin)
        && request.resource.data.code is string
        && get(/databases/$(database)/documents/config/admin).data.code.size() >= 16
        && request.resource.data.code == get(/databases/$(database)/documents/config/admin).data.code;
    }
    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['role', 'how', 'code', 'by', 'at', 'name', 'email'])
        && (isAdmin() || (request.auth.uid == uid && codeOk()));
      allow update, delete: if isAdmin();
    }

    // The admin access code: only admins can see or change it.
    match /config/admin {
      allow read, write: if isAdmin();
    }
  }
}
